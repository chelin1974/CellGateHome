{
  "uid": "cellgate-home",
  "title": "CellGate Home",
  "description": "Gate state from the CellGateHome bridge. The bridge pushes cellgate_gate_open over OTLP: 1 while a gate is open, 0 while closed, with gate and location labels.",
  "tags": ["cellgate", "homekit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "gate",
        "label": "Gate",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(cellgate_gate_open, gate)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gate now",
      "description": "Open or closed, as last reported. \"Unknown\" means nothing currently says where the gate is: either the bridge has not managed a reading yet, or the unit has no position sensor and no opening is in progress.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cellgate_gate_open{gate=~\"$gate\"}",
          "legendFormat": "{{gate}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Closed", "color": "green", "index": 0 },
                "1": { "text": "Open", "color": "orange", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Open and closed over time",
      "description": "A band per gate. Useful for spotting a gate left open, or a run of openings.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cellgate_gate_open{gate=~\"$gate\"}",
          "legendFormat": "{{gate}}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Closed", "color": "green", "index": 0 },
                "1": { "text": "Open", "color": "orange", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Openings per hour",
      "description": "Counted from closed-to-open transitions, so a gate held open does not inflate it. Only meaningful for a gate with a position sensor wired to its status input: without one the series exists only while an opening is assumed, so this figure measures the sampling, not the gate. See the README.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (gate) (increase(clamp_min(idelta(cellgate_gate_open{gate=~\"$gate\"}[5m]), 0)[1h:5m]))",
          "legendFormat": "{{gate}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Share of time open",
      "description": "Average of the open/closed signal over a rolling hour: 0 is always closed, 1 is always open. Only meaningful for a gate with a position sensor wired to its status input: without one the series exists only while an opening is assumed, so this figure measures the sampling, not the gate. See the README.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(cellgate_gate_open{gate=~\"$gate\"}[1h])",
          "legendFormat": "{{gate}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Readings received",
      "description": "How many gate series the bridge is reporting. A drop to zero means the bridge stopped pushing - it polls every 20 seconds by default, so this should be flat.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(cellgate_gate_open)",
          "legendFormat": "gates reporting"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      }
    }
  ]
}
